---
import Base from '../layouts/Base.astro';

const title = "Réalisations — Craie & Cobalt, architecte d'intérieur à Lyon";
const description =
  "Appartements, maisons, boutiques et bureaux rénovés à Lyon et dans la métropole : photos, surface, durée et budget de chaque projet.";
---

<Base title={title} description={description}>
  <section class="section">
    <div class="conteneur">
      <p class="etiquette surtitre">Lyon et la métropole</p>
      <h1>Réalisations</h1>
      <p class="chapeau">Une sélection de projets menés à Lyon et dans la métropole.</p>
    </div>
  </section>
</Base>
