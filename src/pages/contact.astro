---
import Base from '../layouts/Base.astro';

const title = "Contact — Craie & Cobalt, architecte d'intérieur à Lyon";
const description =
  "Parlez-nous de votre projet de rénovation ou d'aménagement à Lyon. Réponse sous 48 heures ouvrées, visite-conseil sur rendez-vous.";
---

<Base title={title} description={description}>
  <section class="section">
    <div class="conteneur">
      <h1>Parlons de votre projet</h1>
      <p class="chapeau">Quelques informations suffisent pour commencer. Nous vous répondons sous 48 heures ouvrées pour fixer un premier rendez-vous.</p>
    </div>
  </section>
</Base>
