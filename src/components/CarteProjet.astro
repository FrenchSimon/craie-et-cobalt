---
/*
 * Carte d'une réalisation : photo 4:3, « Type · Lieu », titre et fiche technique.
 * Accueil : le titre (H3) est un lien vers la fiche, nom accessible court.
 * Réalisations : titre H2 et bouton « Voir la fiche + », qui ouvre le panneau latéral.
 * Dans les deux cas, toute la carte se clique : la zone du lien ou du bouton est étendue
 * à la carte par un pseudo-élément.
 */
import Photo from './Photo.astro';
import type { Projet } from '../data/projets';

interface Props {
  projet: Projet;
  /** Réalisations : H2 et bouton qui ouvre la fiche (accueil par défaut : H3 et lien). */
  fiche?: boolean;
  /** Première carte de la page Réalisations : photo chargée tout de suite (LCP en mobile). */
  prioritaire?: boolean;
}

const { projet, fiche = false, prioritaire = false } = Astro.props;
const titre = fiche ? projet.titre : (projet.phare?.titre ?? projet.titre);
const lieu = fiche ? projet.lieu : (projet.phare?.lieu ?? projet.lieu);
const photo = projet.photos[0];
const Titre = fiche ? 'h2' : 'h3';
---

<article class="carte-projet">
  <Photo
    src={photo.src}
    alt={photo.alt}
    widths={[400, 640, 860, 1240]}
    sizes="(min-width: 1440px) 411px, (min-width: 900px) calc((100vw - 11vw - 48px) / 3), calc(100vw - 11vw)"
    prioritaire={prioritaire}
    class="carte-projet__photo"
  />
  <p class="etiquette carte-projet__type">{projet.categorie} · {lieu}</p>
  <Titre class="carte-projet__titre">
    {fiche ? titre : <a class="carte-projet__lien" href={`/realisations#${projet.id}`}>{titre}</a>}
  </Titre>
  <dl class="fiche-technique">
    <div>
      <dt>Surface</dt>
      <dd>{projet.surface}</dd>
    </div>
    <div>
      <dt>Durée</dt>
      <dd>{projet.duree}</dd>
    </div>
  </dl>
  {fiche && (
    <button
      class="carte-projet__lien carte-projet__bouton lien ui"
      type="button"
      aria-haspopup="dialog"
      aria-controls={`fiche-${projet.id}`}
      data-ouvre={projet.id}
    >
      Voir la fiche<span class="visuellement-masque"> : {projet.titre}</span>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0v12M0 6h12" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
  )}
</article>

<style>
  .carte-projet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Toutes les cartes au même format 4:3, photo recadrée au centre */
  .carte-projet :global(.carte-projet__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .carte-projet__lien {
    color: var(--graphite);
    text-decoration: none;
    transition: color var(--transition);
  }

  /* Zone cliquable étendue à toute la carte */
  .carte-projet__lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .carte-projet:hover .carte-projet__lien {
    color: var(--cobalt);
  }

  .carte-projet__titre {
    transition: color var(--transition);
  }

  /* Réalisations : titre cobalt au survol, comme le lien de l'accueil */
  .carte-projet:hover h2.carte-projet__titre {
    color: var(--cobalt);
  }

  /* Bouton « Voir la fiche + » : lien souligné, croix à droite, cible de 44 px */
  .carte-projet__bouton {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    text-decoration: underline 2px var(--graphite);
    text-underline-offset: 6px;
    cursor: pointer;
  }

  .carte-projet:hover .carte-projet__bouton {
    text-decoration-color: var(--cobalt);
  }

  /* Survol : encadré cobalt de 1 px (comme les boutons) autour de toute la carte, dans la gouttière */
  .carte-projet__lien::after {
    outline: 1px solid transparent;
    outline-offset: 10px;
    transition: outline-color var(--transition);
  }

  .carte-projet:hover .carte-projet__lien::after {
    outline-color: var(--cobalt);
  }

  /* Focus : contour autour de toute la carte, pas seulement du titre */
  .carte-projet__lien:focus-visible {
    outline: none;
  }

  /* Focus clavier : 2 px, comme partout, pour rester bien visible */
  .carte-projet__lien:focus-visible::after {
    outline-width: 2px;
    outline-color: var(--focus);
  }

  /* Fiche technique : deux colonnes séparées par un filet vertical */
  .fiche-technique {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--pas-2);
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--filet);
  }

  .fiche-technique div + div {
    padding-left: var(--pas-2);
    border-left: 1px solid var(--filet);
  }

  .fiche-technique dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .fiche-technique dd {
    margin-top: 4px;
    font-family: var(--titre);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
  }
</style>
