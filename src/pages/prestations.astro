---
import Base from '../layouts/Base.astro';

const title = "Prestations — Craie & Cobalt, architecte d'intérieur à Lyon";
const description =
  "Visite-conseil, conception complète, suivi de chantier et aménagement de lieux professionnels à Lyon. Honoraires clairs, devis détaillé avant tout engagement.";
---

<Base title={title} description={description}>
  <section class="section">
    <div class="conteneur">
      <h1>Nos prestations</h1>
      <p class="chapeau">Chaque projet est différent. Vous pouvez faire appel au studio pour un conseil ponctuel ou pour l'ensemble du projet, du premier croquis à la remise des clés.</p>
    </div>
  </section>
</Base>
