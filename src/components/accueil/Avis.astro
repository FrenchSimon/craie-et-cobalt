---
import TeteSection from '../TeteSection.astro';
import FlecheSortante from '../FlecheSortante.astro';

/* Avis fictifs, signalés comme tels ; le lien vers Google est désactivé (aucune vraie fiche). */

const avis = [
  {
    citation:
      'Margaux a compris en une visite ce que nous cherchions depuis deux ans. Le chantier a duré quatre mois, sans une mauvaise surprise.',
    auteur: 'Claire et Antoine',
    contexte: 'appartement à la Croix-Rousse',
  },
  {
    citation: 'Notre boutique a enfin une identité. Les clientes nous en parlent encore.',
    auteur: 'Sophie',
    contexte: "gérante d'une boutique de prêt-à-porter",
  },
  {
    citation: "Des plans d'une précision rare et un budget tenu à l'euro près.",
    auteur: 'Julien',
    contexte: 'maison à Caluire-et-Cuire',
  },
];
---

<section class="section" aria-labelledby="titre-avis">
  <div class="conteneur">
    <TeteSection surtitre="Avis" titre="Ils nous ont confié leur intérieur" id="titre-avis" />

    <ul class="avis liste-nue">
      {avis.map(({ citation, auteur, contexte }) => (
        <li>
          <figure class="avis__carte">
            <span class="avis__guillemet" aria-hidden="true">«</span>
            <blockquote class="avis__citation">
              <p>{citation}</p>
            </blockquote>
            <figcaption class="avis__auteur"><b>{auteur}</b>, {contexte}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="avis__pied">
      <p class="avis__mention">Avis fictifs.</p>
      <p class="ui">
        <span class="lien-fictif">Lire tous nos avis sur <span class="avis__insecable">Google<FlecheSortante /></span></span>
        <span class="fictif">Fictif</span>
      </p>
    </div>
  </div>
</section>

<style>
  .avis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pas-3);
  }

  .avis > li {
    display: flex;
  }

  .avis__carte {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding: 26px 28px;
    border: 1px solid var(--filet);
    background: var(--craie-claire);
  }

  .avis__guillemet {
    font-family: var(--texte);
    font-size: 56px;
    font-weight: 600;
    line-height: 0.6;
    color: var(--cobalt);
  }

  .avis__citation {
    flex: 1;
    font-size: 21px;
    line-height: 1.45;
  }

  .avis__auteur {
    padding-top: 12px;
    border-top: 1px solid var(--filet);
    font-family: var(--titre);
    font-size: 14px;
    color: var(--gris);
  }

  .avis__auteur b {
    color: var(--graphite);
  }

  .avis__pied {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px var(--pas-4);
    margin-top: 20px;
  }

  .avis__insecable {
    white-space: nowrap;
  }

  .avis__mention {
    font-size: 16px;
    color: var(--gris);
  }

  @media (max-width: 899.98px) {
    .avis {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
