---
import Base from '../layouts/Base.astro';
import TetePage from '../components/TetePage.astro';
import CarteProjet from '../components/CarteProjet.astro';
import FicheProjet from '../components/realisations/FicheProjet.astro';
import AppelAction from '../components/AppelAction.astro';
import { projets, type Categorie } from '../data/projets';

const title = "Réalisations — Craie & Cobalt, architecte d'intérieur à Lyon";
const description =
  "Appartements, maisons, boutiques et bureaux rénovés à Lyon et dans la métropole : photos, surface, durée et budget de chaque projet.";

const filtres: { valeur: 'tous' | Categorie; texte: string }[] = [
  { valeur: 'tous', texte: 'Tous' },
  { valeur: 'Particuliers', texte: 'Particuliers' },
  { valeur: 'Professionnels', texte: 'Professionnels' },
];
---

<Base title={title} description={description}>
  <TetePage
    surtitre="Lyon et la métropole"
    titre="Réalisations"
    chapeau="Une sélection de projets menés à Lyon et dans la métropole."
  />

  {/*
    Galerie : filtres (aria-pressed, résultat annoncé), grille de cartes ; chaque carte ouvre
    sa fiche dans un panneau latéral. La grille ne bouge pas à l'ouverture.
  */}
  <section class="galerie conteneur" aria-labelledby="titre-galerie">
    <h2 class="visuellement-masque" id="titre-galerie">Les projets</h2>

    {/* Filtres affichés par le script : sans lui, tous les projets restent visibles */}
    <div class="galerie__filtres" hidden>
      <div class="filtres ui" role="group" aria-label="Filtrer les projets">
        {filtres.map((filtre, index) => (
          <button class="filtres__bouton" type="button" data-filtre={filtre.valeur} aria-pressed={index === 0 ? 'true' : 'false'}>
            {filtre.texte}
          </button>
        ))}
      </div>
      <p class="etiquette galerie__annonce" aria-live="polite">{projets.length} projets affichés</p>
    </div>

    <ul class="galerie__liste liste-nue">
      {projets.map((projet, index) => (
        <li class="galerie__projet" id={projet.id} data-categorie={projet.categorie}>
          <CarteProjet
            projet={projet}
            fiche
            prioritaire={index === 0}
            sizes="(min-width: 1440px) 405px, (min-width: 1200px) calc((100vw - 11vw - 64px) / 3), (min-width: 900px) calc((100vw - 11vw - 32px) / 2), calc(100vw - 11vw)"
          />
          <FicheProjet projet={projet} rang={index + 1} total={projets.length} />
        </li>
      ))}
    </ul>

    <p class="galerie__mention">Projets fictifs (démo) : les photos proviennent de banques d'images libres de droits.</p>
  </section>

  <AppelAction titre="Votre projet pourrait être le prochain." />
</Base>

<script>
  import '../scripts/realisations';
</script>

<style>
  .galerie {
    padding-bottom: var(--espace-section);
  }

  /* Filtres, puis le nombre de projets affichés juste à côté (dessous en mobile) */
  .galerie__filtres:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pas-2) var(--pas-3);
    margin-bottom: 40px;
  }

  /* Filtres accolés, contour cobalt 1 px ; actif plein cobalt ; survol fond cobalt pâle */
  .filtres {
    display: flex;
  }

  .filtres__bouton {
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--cobalt);
    background: transparent;
    color: var(--cobalt);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .filtres__bouton + .filtres__bouton {
    border-left: 0;
  }

  .filtres__bouton:hover:not([aria-pressed='true']) {
    background: var(--cobalt-pale);
  }

  .filtres__bouton[aria-pressed='true'] {
    background: var(--cobalt);
    color: var(--craie);
  }

  /* Le contour de focus passe au-dessus du bouton voisin */
  .filtres__bouton:focus-visible {
    position: relative;
  }

  /*
   * Grille de 3 colonnes. Chaque carte occupe 5 rangées partagées (sous-grille : photo,
   * étiquette, titre, fiche technique, bouton) : un titre sur deux lignes décale toute la
   * rangée, et les fiches techniques restent alignées d'une carte à l'autre.
   */
  .galerie__liste {
    --espace-cartes: 64px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* L'écart entre rangées vaut aussi à l'intérieur des cartes (sous-grille) : 12 px ici,
       l'espace entre deux cartes est porté par le bas de chacune */
    gap: 12px var(--pas-4);
  }

  .galerie__projet,
  .galerie__projet > :global(.carte-projet) {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }

  .galerie__projet {
    padding-bottom: calc(var(--espace-cartes) - 12px);
  }

  /* Projet écarté par le filtre (la grille ci-dessus l'emporterait sur l'attribut hidden) */
  .galerie__projet[hidden] {
    display: none;
  }

  /* Écrans moyens : 3 colonnes trop étroites pour les titres et les chiffres, grille en 2 colonnes */
  @media (min-width: 900px) and (max-width: 1199.98px) {
    .galerie__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* L'espace au-dessus vient du bas de la dernière carte */
  .galerie__mention {
    margin-top: 0;
    font-size: 16px;
    color: var(--gris);
  }

  @media (max-width: 899.98px) {
    .galerie__liste {
      --espace-cartes: 56px;
      grid-template-columns: minmax(0, 1fr);
    }

    /* Les trois filtres se partagent la largeur */
    .filtres {
      width: 100%;
    }

    .filtres__bouton {
      flex: 1 1 auto;
      padding: 0 10px;
    }
  }
</style>
