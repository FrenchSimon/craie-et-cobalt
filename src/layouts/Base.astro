---
import '../styles/global.css';
import sansJs from '../styles/sans-js.css?url';
import favicon from '../../contenu/logo/favicon.svg?url';
import policeTitre from '../assets/fonts/archivo-latin-400-600-largeur-112.woff2?url';
import LienEvitement from '../components/LienEvitement.astro';
import EnTete from '../components/EnTete.astro';
import AppelAction from '../components/AppelAction.astro';
import PiedDePage from '../components/PiedDePage.astro';

interface Props {
  title: string;
  description: string;
  /** Faux pour la page 404 : pas de lien canonique. */
  canonique?: boolean;
  /** Faux pour la page Contact : l'appel à l'action y mènerait vers elle-même. */
  appelAction?: boolean;
}

const { title, description, canonique = true, appelAction = true } = Astro.props;

const site = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname.replace(/\.html$/, ''), site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Démo : ne doit jamais apparaître dans les résultats de recherche. */}
    <meta name="robots" content="noindex" />
    {canonique && <link rel="canonical" href={url} />}
    <meta name="theme-color" content="#1E2229" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {/* Police des titres préchargée : elle sert au titre de l'accroche. */}
    <link rel="preload" href={policeTitre} as="font" type="font/woff2" crossorigin />
    <noscript><link rel="stylesheet" href={sansJs} /></noscript>
    <slot name="head" />
  </head>
  <body>
    <LienEvitement />
    <EnTete />
    <main id="contenu">
      <slot />
      {/* Appel à l'action commun, juste avant le pied de page graphite qui le prolonge */}
      {appelAction && (
        <AppelAction
          titre="Un projet en tête ?"
          texte="Racontez-nous votre lieu et vos envies. Nous vous répondons sous 48 heures ouvrées."
        />
      )}
    </main>
    <PiedDePage />
  </body>
</html>
