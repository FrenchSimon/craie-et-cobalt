---
/* Tête de section : surtitre cobalt et titre H2. Les liens secondaires vont en fin de section. */
interface Props {
  surtitre: string;
  titre: string;
  /** Identifiant du H2, qui nomme la section (aria-labelledby). */
  id: string;
}

const { surtitre, titre, id } = Astro.props;
---

<div class="tete-section">
  <p class="etiquette surtitre">{surtitre}</p>
  <h2 id={id}>{titre}</h2>
</div>

<style>
  .tete-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: var(--pas-5);
  }
</style>
