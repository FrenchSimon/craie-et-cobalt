---
import '../styles/global.css';
import sansJs from '../styles/sans-js.css?url';
import favicon from '../../contenu/logo/favicon.svg?url';
import policeTitre from '../assets/fonts/archivo-latin-400-600-largeur-112.woff2?url';
import LienEvitement from '../components/LienEvitement.astro';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import RetourHaut from '../components/RetourHaut.astro';
import { cheminNormalise } from '../data/navigation';
import { imagePartage, altPartage } from '../data/partage';

interface Props {
  title: string;
  description: string;
  /** Faux pour la page 404 : ni lien canonique, ni og:url. */
  canonique?: boolean;
}

const { title, description, canonique = true } = Astro.props;

const site = Astro.site ?? Astro.url;
// Adresse publique de la page : « / » pour l'accueil (construit en index.html), sans extension ailleurs.
const url = new URL(cheminNormalise(Astro.url.pathname), site).href;
const image = new URL(imagePartage.src, site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Démo : ne doit jamais apparaître dans les résultats de recherche. */}
    <meta name="robots" content="noindex" />
    {canonique && <link rel="canonical" href={url} />}
    <meta name="theme-color" content="#1E2229" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Police des titres préchargée : elle sert au titre de l'accroche. */}
    <link rel="preload" href={policeTitre} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Craie & Cobalt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonique && <meta property="og:url" content={url} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altPartage} />
    <meta name="twitter:card" content="summary_large_image" />

    <noscript><link rel="stylesheet" href={sansJs} /></noscript>
    <slot name="head" />
  </head>
  <body id="haut">
    <LienEvitement />
    <EnTete />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage />
    <RetourHaut />
  </body>
</html>
