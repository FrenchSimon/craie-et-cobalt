---
import Base from '../layouts/Base.astro';

const title = "Le studio — Margaux Delorme, architecte d'intérieur à Lyon";
const description =
  "Craie & Cobalt est le studio de Margaux Delorme, architecte d'intérieur à Lyon. Une démarche précise, des artisans de confiance et une seule interlocutrice.";
---

<Base title={title} description={description}>
  <section class="section">
    <div class="conteneur">
      <h1>Le studio</h1>
    </div>
  </section>
</Base>
