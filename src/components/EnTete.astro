---
import MotSymbole from '../../contenu/logo/mot-symbole.svg';
import BandeauDemo from './BandeauDemo.astro';
import { menu, contact, cheminNormalise } from '../data/navigation';

const courant = cheminNormalise(Astro.url.pathname);
const page = (href: string) => (cheminNormalise(href) === courant ? 'page' : undefined);
---

<header class="en-tete">
  {/* Bandeau démo dans la bannière : aucun contenu hors des régions de la page */}
  <BandeauDemo />
  <div class="en-tete__barre conteneur">
    <a class="en-tete__logo" href="/" aria-label="Craie & Cobalt, accueil" aria-current={page('/')}>
      <MotSymbole aria-hidden="true" />
    </a>

    <button class="en-tete__bouton-menu" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
      <svg class="en-tete__traits" width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2"></path></svg>
      <svg class="en-tete__croix" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="2"></path></svg>
    </button>

    <nav class="menu ui" id="menu" aria-label="Menu principal">
      <ul class="menu__liens liste-nue">
        {menu.map(({ href, texte }) => (
          <li><a class="menu__lien" href={href} aria-current={page(href)}>{texte}</a></li>
        ))}
      </ul>
      <a class="bouton bouton--petit menu__contact" href={contact.href} aria-current={page(contact.href)}>{contact.texte}</a>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .en-tete {
    position: relative;
    border-bottom: 1px solid var(--filet);
  }

  .en-tete__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pas-3);
    min-height: 88px;
  }

  /* Mot-symbole à la taille d'un texte de 20 px */
  .en-tete__logo {
    display: block;
    flex-shrink: 0;
    padding-block: 8px;
  }

  .en-tete__logo :global(svg) {
    width: 226px;
    height: auto;
  }

  .menu,
  .menu__liens {
    display: flex;
    align-items: center;
    gap: var(--pas-4);
  }

  .menu__lien {
    display: inline-block;
    padding-block: 12px;
    color: var(--graphite);
    text-decoration: underline 2px transparent;
    text-underline-offset: 8px;
    transition:
      color var(--transition),
      text-decoration-color var(--transition);
  }

  .menu__lien:hover {
    color: var(--cobalt);
  }

  /* Page courante : souligné graphite 2 px décalé de 8 px */
  .menu__lien[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  /* Page Contact : bouton au contour (l'inverse de son état habituel) */
  .menu__contact[aria-current='page'] {
    background: transparent;
    color: var(--cobalt);
  }

  .en-tete__bouton-menu {
    display: none;
  }

  /* Mobile : bouton 48 × 48 qui déroule le menu sous l'en-tête */
  @media (max-width: 899.98px) {
    .en-tete__logo :global(svg) {
      width: 200px;
    }

    .en-tete__bouton-menu {
      display: inline-grid;
      place-items: center;
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 1px solid var(--graphite);
      background: none;
      color: var(--graphite);
      cursor: pointer;
    }

    .en-tete__bouton-menu > svg {
      grid-area: 1 / 1;
    }

    .en-tete__croix,
    .en-tete__bouton-menu[aria-expanded='true'] .en-tete__traits {
      display: none;
    }

    .en-tete__bouton-menu[aria-expanded='true'] .en-tete__croix {
      display: block;
    }

    /* Menu ouvert : la page dessous ne défile pas */
    :global(html:has(.en-tete--menu-ouvert)) {
      overflow: hidden;
    }

    /* Menu ouvert : l'en-tête entier (bandeau, logo, bouton, menu) couvre tout l'écran */
    .en-tete--menu-ouvert {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-bottom: 0;
      background: var(--craie);
    }

    /* Logo et bouton gardent leur ligne de 88 px sous le bandeau, le menu prend la suite */
    .en-tete--menu-ouvert .en-tete__barre {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 88px auto;
      align-items: center;
      align-content: start;
      flex: 1;
    }

    .en-tete--menu-ouvert .menu {
      grid-column: 1 / -1;
    }

    /* Menu masqué tant que le bouton ne l'a pas ouvert (sans JS : sans-js.css le laisse visible) */
    .menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      flex-basis: 100%;
      padding: var(--pas-2) 0 var(--pas-5);
      border-top: 1px solid var(--filet);
    }

    .menu.menu--ouvert {
      display: flex;
    }

    .menu__liens {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .menu__liens li + li {
      border-top: 1px solid var(--filet);
    }

    .menu__lien {
      display: block;
      padding-block: 18px;
      font-size: 24px;
    }

    .menu__contact {
      align-self: flex-start;
      margin-top: var(--pas-4);
    }
  }
</style>
