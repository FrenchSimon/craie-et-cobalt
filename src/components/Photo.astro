---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * Photo du site : AVIF puis WebP, repli JPEG, en plusieurs largeurs.
 * Largeur et hauteur écrites par Astro (aucun décalage de mise en page).
 * Différée par défaut ; seule l'image principale d'une page passe `prioritaire`.
 * Pas de `layout` responsive d'Astro : il ajoute des styles en ligne, bloqués par la CSP.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Largeurs générées, en pixels (la plus grande ne dépasse pas le master). */
  widths: number[];
  /** Largeur affichée selon l'écran, pour que le navigateur choisisse la bonne taille. */
  sizes: string;
  prioritaire?: boolean;
  class?: string;
}

const { src, alt, widths, sizes, prioritaire = false, class: classe } = Astro.props;
// Une largeur plus grande que le master est remplacée par celle du master (jamais d'agrandissement).
const largeurs = [...new Set(widths.map((largeur) => Math.min(largeur, src.width)))];
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={largeurs}
  sizes={sizes}
  loading={prioritaire ? 'eager' : 'lazy'}
  decoding={prioritaire ? 'sync' : 'async'}
  fetchpriority={prioritaire ? 'high' : undefined}
  class={classe}
/>
